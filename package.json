{
  "name": "gds-preview",
  "displayName": "gds-preview",
  "description": "A VS Code extension to preview GDSII files.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:gds-preview.previewGds"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "gds",
        "aliases": [
          "GDSII",
          "OASIS"
        ],
        "extensions": [
          ".gds",
          ".gdsii",
          ".GDS",
          ".oas",
          ".OAS"
        ],
        "mimetypes": [
          "application/gds",
          "application/oasis"
        ]
      }
    ],
    "commands": [
      {
        "command": "gds-preview.previewGds",
        "title": "Preview GDS File",
        "icon": "$(file-media)"
      }
    ],
    "customEditors": [
      {
        "viewType": "gds-preview.gdsPreview",
        "displayName": "GDS Preview",
        "selector": [
          {
            "filenamePattern": "*.{gds,gdsii,GDS,oas,OAS}"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceExtname == .gds || resourceExtname == .gdsii || resourceExtname == .GDS || resourceExtname == .oas || resourceExtname == .OAS",
          "command": "gds-preview.previewGds",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.107.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  }
}
