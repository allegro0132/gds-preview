{
  "name": "gds-preview-desktop",
  "version": "0.3.5",
  "description": "Desktop version of GDS Preview",
  "author": {
    "name": "AllegroMorphic",
    "email": "34514398+allegro0132@users.noreply.github.com"
  },
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/allegro0132/gds-preview.git"
  },
  "scripts": {
    "start": "node scripts/prepare_resources.js && electron .",
    "pack": "node scripts/prepare_resources.js && electron-builder --dir",
    "dist": "node scripts/prepare_resources.js && electron-builder"
  },
  "build": {
    "appId": "com.allegromorphic.gdspreview",
    "productName": "GDSII Preview",
    "icon": "icon.png",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "files": [
      "**/*",
      {
        "from": "../webview-ui",
        "to": "webview-ui",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraResources": [
      "resources/gds-engine"
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {}
}
