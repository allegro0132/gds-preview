{
  "name": "gds-preview-desktop",
  "version": "0.3.3",
  "description": "Desktop version of GDS Preview",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/allegro0132/gds-preview.git"
  },
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.allegromorphic.gdspreview",
    "productName": "GDSII Preview",
    "icon": "icon.png",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "zip"]
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development"
    },
    "files": [
      "**/*",
      {
        "from": "../webview-ui",
        "to": "webview-ui",
        "filter": ["**/*"]
      }
    ],
    "extraResources": [
      "resources/gds-engine"
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {}
}
